# MoKairos Studio CMake 工具链模块（兼容 CMake 3.10+）
# 由 MoKairos Studio / mokairos-ui {{ cli_version }} 生成，支持离线持久化缓存与增量重建。

if(CMAKE_VERSION VERSION_LESS "3.10")
    message(FATAL_ERROR "[MoKairosUI] 需要 CMake >= 3.10")
endif()

if(DEFINED __MOKAIROS_UI_CMAKE_LOADED)
    return()
endif()
set(__MOKAIROS_UI_CMAKE_LOADED TRUE)

# 默认版本、发布源与校验和（可通过 -DMOKAIROS_UI_* 覆盖）
set(MOKAIROS_UI_VERSION "{{ default_version }}" CACHE STRING "MoKairos UI CLI 版本（可设为 latest）")
set(MOKAIROS_UI_BASE_URL "{{ default_base_url }}" CACHE STRING "MoKairos UI CLI 下载源（支持镜像与 file://）")
set(MOKAIROS_UI_CLI "" CACHE FILEPATH "本地 mokairos-ui 可执行文件路径（设置后跳过下载）")
option(MOKAIROS_UI_OFFLINE "仅使用本地持久化缓存或 MOKAIROS_UI_CLI，禁止联网" OFF)

set(MOKAIROS_UI_SHA256_WINDOWS_X64 "{{ sha256_windows_x64 }}" CACHE STRING "windows-x64 CLI SHA256")
set(MOKAIROS_UI_SHA256_LINUX_X64 "{{ sha256_linux_x64 }}" CACHE STRING "linux-x64 CLI SHA256")
set(MOKAIROS_UI_SHA256_LINUX_ARM64 "{{ sha256_linux_arm64 }}" CACHE STRING "linux-arm64 CLI SHA256")
set(MOKAIROS_UI_SHA256_MACOS_ARM64 "{{ sha256_macos_arm64 }}" CACHE STRING "macos-arm64 CLI SHA256")
set(MOKAIROS_UI_SHA256_MACOS_X64 "{{ sha256_macos_x64 }}" CACHE STRING "macos-x64 CLI SHA256")

if(NOT DEFINED MOKAIROS_UI_CACHE_DIR OR "${MOKAIROS_UI_CACHE_DIR}" STREQUAL "")
    if(DEFINED ENV{MOKAIROS_UI_CACHE} AND NOT "$ENV{MOKAIROS_UI_CACHE}" STREQUAL "")
        set(_mk_default_cache "$ENV{MOKAIROS_UI_CACHE}")
    elseif(CMAKE_HOST_WIN32)
        if(DEFINED ENV{LOCALAPPDATA} AND NOT "$ENV{LOCALAPPDATA}" STREQUAL "")
            file(TO_CMAKE_PATH "$ENV{LOCALAPPDATA}/mokairos-ui" _mk_default_cache)
        else()
            file(TO_CMAKE_PATH "$ENV{USERPROFILE}/.cache/mokairos-ui" _mk_default_cache)
        endif()
    elseif(CMAKE_HOST_APPLE)
        set(_mk_default_cache "$ENV{HOME}/Library/Caches/mokairos-ui")
    else()
        if(DEFINED ENV{XDG_CACHE_HOME} AND NOT "$ENV{XDG_CACHE_HOME}" STREQUAL "")
            set(_mk_default_cache "$ENV{XDG_CACHE_HOME}/mokairos-ui")
        else()
            set(_mk_default_cache "$ENV{HOME}/.cache/mokairos-ui")
        endif()
    endif()
    set(MOKAIROS_UI_CACHE_DIR "${_mk_default_cache}" CACHE PATH "mokairos-ui 持久缓存目录")
endif()

set_property(GLOBAL PROPERTY _MOKAIROS_UI_REGISTERED_TARGETS "")

function(_mokairos_detect_host_asset out_asset out_key out_bin_name)
    string(TOLOWER "${CMAKE_HOST_SYSTEM_PROCESSOR}" _arch)
    if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows")
        if(_arch STREQUAL "amd64" OR _arch STREQUAL "x86_64")
            set(${out_asset} "mokairos-ui-windows-x64.exe" PARENT_SCOPE)
            set(${out_key} "WINDOWS_X64" PARENT_SCOPE)
            set(${out_bin_name} "mokairos-ui.exe" PARENT_SCOPE)
            return()
        endif()
    elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
        if(_arch STREQUAL "x86_64" OR _arch STREQUAL "amd64")
            set(${out_asset} "mokairos-ui-linux-x64" PARENT_SCOPE)
            set(${out_key} "LINUX_X64" PARENT_SCOPE)
            set(${out_bin_name} "mokairos-ui" PARENT_SCOPE)
            return()
        elseif(_arch STREQUAL "aarch64" OR _arch STREQUAL "arm64")
            set(${out_asset} "mokairos-ui-linux-arm64" PARENT_SCOPE)
            set(${out_key} "LINUX_ARM64" PARENT_SCOPE)
            set(${out_bin_name} "mokairos-ui" PARENT_SCOPE)
            return()
        endif()
    elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
        if(_arch STREQUAL "arm64")
            set(${out_asset} "mokairos-ui-macos-arm64" PARENT_SCOPE)
            set(${out_key} "MACOS_ARM64" PARENT_SCOPE)
            set(${out_bin_name} "mokairos-ui" PARENT_SCOPE)
            return()
        elseif(_arch STREQUAL "x86_64")
            set(${out_asset} "mokairos-ui-macos-x64" PARENT_SCOPE)
            set(${out_key} "MACOS_X64" PARENT_SCOPE)
            set(${out_bin_name} "mokairos-ui" PARENT_SCOPE)
            return()
        endif()
    endif()
    message(FATAL_ERROR
        "[MoKairosUI] 不支持的宿主平台: ${CMAKE_HOST_SYSTEM_NAME} / ${CMAKE_HOST_SYSTEM_PROCESSOR}\n"
        "请自行编译 mokairos-ui 并通过 -DMOKAIROS_UI_CLI=<path> 指定本地可执行文件。")
endfunction()

function(_mokairos_read_sha256_sidecar sidecar_path out_hash)
    set(_h "")
    if(EXISTS "${sidecar_path}")
        file(READ "${sidecar_path}" _raw)
        string(STRIP "${_raw}" _raw)
        string(REGEX MATCH "^[0-9a-fA-F]+" _cand "${_raw}")
        string(LENGTH "${_cand}" _cand_len)
        if(_cand_len EQUAL 64)
            string(TOLOWER "${_cand}" _h)
        endif()
    endif()
    set(${out_hash} "${_h}" PARENT_SCOPE)
endfunction()

function(_mokairos_find_fallback_cache asset bin_name out_cli out_ver)
    file(GLOB _candidates "${MOKAIROS_UI_CACHE_DIR}/*/${asset}/${bin_name}")
    set(_best_cli "")
    set(_best_ver "")
    foreach(_cand IN LISTS _candidates)
        get_filename_component(_asset_dir "${_cand}" DIRECTORY)
        get_filename_component(_ver_dir "${_asset_dir}" DIRECTORY)
        get_filename_component(_cand_ver "${_ver_dir}" NAME)
        _mokairos_read_sha256_sidecar("${_cand}.sha256" _sidecar_sha)
        if(NOT "${_sidecar_sha}" STREQUAL "")
            file(SHA256 "${_cand}" _actual_sha)
            string(TOLOWER "${_actual_sha}" _actual_sha)
            if(NOT "${_actual_sha}" STREQUAL "${_sidecar_sha}")
                continue()
            endif()
        else()
            continue()
        endif()
        if("${_best_ver}" STREQUAL "" OR "${_cand_ver}" VERSION_GREATER "${_best_ver}")
            set(_best_ver "${_cand_ver}")
            set(_best_cli "${_cand}")
        endif()
    endforeach()
    set(${out_cli} "${_best_cli}" PARENT_SCOPE)
    set(${out_ver} "${_best_ver}" PARENT_SCOPE)
endfunction()

function(_mokairos_ensure_executable path)
    if(NOT CMAKE_HOST_WIN32)
        execute_process(COMMAND chmod +x "${path}" RESULT_VARIABLE _rc)
    endif()
endfunction()

function(_mokairos_resolve_cli out_cli)
    if(NOT "${MOKAIROS_UI_CLI}" STREQUAL "")
        if(NOT EXISTS "${MOKAIROS_UI_CLI}")
            message(FATAL_ERROR "[MoKairosUI] 指定的 MOKAIROS_UI_CLI 不存在: ${MOKAIROS_UI_CLI}")
        endif()
        set(${out_cli} "${MOKAIROS_UI_CLI}" PARENT_SCOPE)
        return()
    endif()

    _mokairos_detect_host_asset(_asset _key _bin_name)
    set(_expected_sha "${MOKAIROS_UI_SHA256_${_key}}")
    string(TOLOWER "${_expected_sha}" _expected_sha)

    set(_target_ver "${MOKAIROS_UI_VERSION}")
    string(REGEX REPLACE "^v" "" _target_ver "${_target_ver}")

    if("${_target_ver}" STREQUAL "latest")
        if(NOT MOKAIROS_UI_OFFLINE)
            set(_latest_tmp "${CMAKE_CURRENT_BINARY_DIR}/.mokairos_latest.txt")
            set(_latest_url "${MOKAIROS_UI_BASE_URL}/../latest/download/latest.txt")
            if("${MOKAIROS_UI_BASE_URL}" MATCHES "^file://")
                set(_latest_url "${MOKAIROS_UI_BASE_URL}/latest.txt")
            endif()
            file(DOWNLOAD "${_latest_url}" "${_latest_tmp}" TLS_VERIFY ON STATUS _l_st)
            list(GET _l_st 0 _l_err)
            if(_l_err EQUAL 0 AND EXISTS "${_latest_tmp}")
                file(READ "${_latest_tmp}" _l_txt)
                string(STRIP "${_l_txt}" _l_txt)
                string(REGEX REPLACE "^v" "" _l_txt "${_l_txt}")
                if(NOT "${_l_txt}" STREQUAL "")
                    set(_target_ver "${_l_txt}")
                endif()
            endif()
            file(REMOVE "${_latest_tmp}")
        endif()
    endif()

    set(_cache_bin "")
    if(NOT "${_target_ver}" STREQUAL "latest")
        set(_ver_dir "${MOKAIROS_UI_CACHE_DIR}/${_target_ver}/${_asset}")
        set(_cache_bin "${_ver_dir}/${_bin_name}")
        set(_sidecar "${_cache_bin}.sha256")
        if(EXISTS "${_cache_bin}")
            set(_verify_sha "${_expected_sha}")
            if("${_verify_sha}" STREQUAL "")
                _mokairos_read_sha256_sidecar("${_sidecar}" _verify_sha)
            endif()
            if(NOT "${_verify_sha}" STREQUAL "")
                file(SHA256 "${_cache_bin}" _actual)
                string(TOLOWER "${_actual}" _actual)
                if("${_actual}" STREQUAL "${_verify_sha}")
                    _mokairos_ensure_executable("${_cache_bin}")
                    set(${out_cli} "${_cache_bin}" PARENT_SCOPE)
                    return()
                else()
                    message(WARNING "[MoKairosUI] 缓存文件校验失败，将移除损坏缓存: ${_cache_bin}")
                    file(REMOVE "${_cache_bin}" "${_sidecar}")
                endif()
            endif()
        endif()
    endif()

    if(NOT MOKAIROS_UI_OFFLINE AND NOT "${_target_ver}" STREQUAL "latest")
        file(MAKE_DIRECTORY "${_ver_dir}")
        set(_dl_url "${MOKAIROS_UI_BASE_URL}/v${_target_ver}/${_asset}")
        set(_part_file "${_ver_dir}/.${_bin_name}.part")
        set(_part_sha "${_ver_dir}/.${_bin_name}.sha256.part")

        if("${_expected_sha}" STREQUAL "")
            file(DOWNLOAD "${_dl_url}.sha256" "${_part_sha}" TLS_VERIFY ON STATUS _s_st)
            list(GET _s_st 0 _s_err)
            if(_s_err EQUAL 0)
                _mokairos_read_sha256_sidecar("${_part_sha}" _expected_sha)
            endif()
            file(REMOVE "${_part_sha}")
        endif()

        message(STATUS "[MoKairosUI] 正在下载 ${_asset} (v${_target_ver}) ...")
        file(DOWNLOAD "${_dl_url}" "${_part_file}" TLS_VERIFY ON STATUS _dl_st)
        list(GET _dl_st 0 _dl_err)
        if(_dl_err EQUAL 0 AND EXISTS "${_part_file}")
            file(SHA256 "${_part_file}" _actual_sha)
            string(TOLOWER "${_actual_sha}" _actual_sha)
            if(NOT "${_expected_sha}" STREQUAL "" AND NOT "${_actual_sha}" STREQUAL "${_expected_sha}")
                file(REMOVE "${_part_file}")
                message(FATAL_ERROR
                    "[MoKairosUI] 下载文件 SHA256 校验失败，已拒绝使用！\n"
                    "  期望: ${_expected_sha}\n"
                    "  实际: ${_actual_sha}")
            endif()
            if("${_expected_sha}" STREQUAL "")
                set(_expected_sha "${_actual_sha}")
            endif()
            file(WRITE "${_sidecar}" "${_expected_sha}  ${_asset}\n")
            file(RENAME "${_part_file}" "${_cache_bin}")
            _mokairos_ensure_executable("${_cache_bin}")
            set(${out_cli} "${_cache_bin}" PARENT_SCOPE)
            return()
        else()
            file(REMOVE "${_part_file}")
            list(GET _dl_st 1 _dl_msg)
            message(WARNING "[MoKairosUI] 下载失败 (${_dl_err}: ${_dl_msg})，尝试回退本地持久化缓存...")
        endif()
    endif()

    _mokairos_find_fallback_cache("${_asset}" "${_bin_name}" _fb_cli _fb_ver)
    if(NOT "${_fb_cli}" STREQUAL "")
        message(WARNING "[MoKairosUI] 已离线回退到本地缓存 CLI: v${_fb_ver} (${_fb_cli})")
        _mokairos_ensure_executable("${_fb_cli}")
        set(${out_cli} "${_fb_cli}" PARENT_SCOPE)
        return()
    endif()

    message(FATAL_ERROR
        "[MoKairosUI] 无法获取 mokairos-ui CLI（无可用下载与本地缓存）。请采用以下任一方式：\n"
        "  1. 检查网络并重新配置（或通过 -DMOKAIROS_UI_BASE_URL=<镜像/file://源> 指定可用源）；\n"
        "  2. 通过 -DMOKAIROS_UI_CLI=<本地路径> 直接指定 mokairos-ui 可执行文件；\n"
        "  3. 将 ${_asset} 与其 .sha256 校验文件放入缓存目录 ${MOKAIROS_UI_CACHE_DIR}/<version>/${_asset}/${_bin_name}。")
endfunction()

function(mokairos_add_ui name)
    cmake_parse_arguments(MK "" "MKUI;TARGET;OUTPUT_DIR;CUSTOM_DIR;PROFILE;BASE_LIB" "FRAMES" ${ARGN})

    if("${MK_MKUI}" STREQUAL "")
        message(FATAL_ERROR "[MoKairosUI] mokairos_add_ui(${name}) 缺少必填参数 MKUI")
    endif()
    get_filename_component(_mkui_abs "${MK_MKUI}" ABSOLUTE)
    if(NOT EXISTS "${_mkui_abs}")
        message(FATAL_ERROR "[MoKairosUI] 找不到 .mkui 文件: ${_mkui_abs}")
    endif()

    get_property(_reg GLOBAL PROPERTY _MOKAIROS_UI_REGISTERED_TARGETS)
    list(FIND _reg "${name}" _dup_idx)
    if(_dup_idx GREATER_EQUAL 0)
        message(FATAL_ERROR "[MoKairosUI] UI 目标名称 `${name}` 重复注册")
    endif()
    list(APPEND _reg "${name}")
    set_property(GLOBAL PROPERTY _MOKAIROS_UI_REGISTERED_TARGETS "${_reg}")

    if(NOT "${MK_TARGET}" STREQUAL "" AND NOT TARGET "${MK_TARGET}")
        message(FATAL_ERROR "[MoKairosUI] 目标 TARGET `${MK_TARGET}` 尚未定义，请先创建固件目标再调用 mokairos_add_ui")
    endif()

    _mokairos_resolve_cli(_cli)

    execute_process(
        COMMAND "${_cli}" --version --json
        OUTPUT_VARIABLE _ver_json
        RESULT_VARIABLE _ver_rc
        OUTPUT_STRIP_TRAILING_WHITESPACE
    )
    if(NOT _ver_rc EQUAL 0)
        message(FATAL_ERROR "[MoKairosUI] CLI 探针执行失败 (${_ver_rc}): ${_cli}")
    endif()
    if(NOT _ver_json MATCHES "\"profile_schema\":[ \t]*\\[([0-9, \t]*,)?[ \t]*1([, \t]|\\])")
        message(FATAL_ERROR "[MoKairosUI] 当前 CLI 不支持 profile schema 1，请升级 mokairos-ui: ${_ver_json}")
    endif()

    if("${MK_OUTPUT_DIR}" STREQUAL "")
        set(_out_dir "${CMAKE_CURRENT_BINARY_DIR}/mokairos_ui/${name}")
    else()
        get_filename_component(_out_dir "${MK_OUTPUT_DIR}" ABSOLUTE)
    endif()

    set(_profile_args "")
    set(_deps "${_mkui_abs}" "${_cli}")
    if(NOT "${MK_PROFILE}" STREQUAL "")
        get_filename_component(_prof_abs "${MK_PROFILE}" ABSOLUTE)
        if(NOT EXISTS "${_prof_abs}")
            message(FATAL_ERROR "[MoKairosUI] 找不到外置 PROFILE 文件: ${_prof_abs}")
        endif()
        list(APPEND _profile_args --profile "${_prof_abs}")
        list(APPEND _deps "${_prof_abs}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_prof_abs}")
    endif()

    set(_base_lib_args "")
    if(NOT "${MK_BASE_LIB}" STREQUAL "")
        get_filename_component(_base_abs "${MK_BASE_LIB}" ABSOLUTE)
        if(NOT EXISTS "${_base_abs}")
            message(FATAL_ERROR "[MoKairosUI] 找不到 BASE_LIB 目录: ${_base_abs}")
        endif()
        list(APPEND _base_lib_args --base-lib "${_base_abs}")
        file(GLOB _base_files "${_base_abs}/*.j2")
        list(APPEND _deps ${_base_files})
        foreach(_bf IN LISTS _base_files)
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_bf}")
        endforeach()
    endif()

    set(_frames_args "")
    if(MK_FRAMES)
        string(REPLACE ";" "," _frames_csv "${MK_FRAMES}")
        list(APPEND _frames_args --frames "${_frames_csv}")
    endif()

    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_mkui_abs}")

    execute_process(
        COMMAND "${_cli}" list-outputs --mkui "${_mkui_abs}" ${_profile_args}
        OUTPUT_VARIABLE _raw_outputs
        ERROR_VARIABLE _list_err
        RESULT_VARIABLE _list_rc
        OUTPUT_STRIP_TRAILING_WHITESPACE
    )
    if(NOT _list_rc EQUAL 0)
        message(FATAL_ERROR "[MoKairosUI] list-outputs 失败:\n${_list_err}")
    endif()

    string(REPLACE "\r\n" "\n" _raw_outputs "${_raw_outputs}")
    string(REPLACE "\n" ";" _rel_outputs "${_raw_outputs}")

    set(_stamp_rel "")
    set(_gen_files "")
    set(_compile_sources "")
    foreach(_rel IN LISTS _rel_outputs)
        if("${_rel}" STREQUAL "")
            continue()
        endif()
        set(_abs "${_out_dir}/${_rel}")
        if(_rel MATCHES "\\.stamp$")
            set(_stamp_rel "${_abs}")
        else()
            list(APPEND _gen_files "${_abs}")
            if(_rel MATCHES "\\.(c|cpp|cc|cxx)$")
                list(APPEND _compile_sources "${_abs}")
            endif()
        endif()
    endforeach()

    if("${_stamp_rel}" STREQUAL "")
        set(_stamp_rel "${_out_dir}/${name}.stamp")
    endif()

    add_custom_command(
        OUTPUT "${_stamp_rel}"
        BYPRODUCTS ${_gen_files}
        COMMAND "${_cli}" generate
            --mkui "${_mkui_abs}"
            --out "${_out_dir}"
            --stamp "${_stamp_rel}"
            ${_profile_args}
            ${_base_lib_args}
            ${_frames_args}
        DEPENDS ${_deps}
        COMMENT "MoKairos UI: generating ${name} from ${_mkui_abs}"
        VERBATIM
    )

    add_custom_target(${name}_codegen DEPENDS "${_stamp_rel}")
    set_source_files_properties(${_gen_files} PROPERTIES GENERATED TRUE)

    add_library(${name} INTERFACE)
    add_dependencies(${name} ${name}_codegen)
    target_sources(${name} INTERFACE ${_compile_sources})
    target_include_directories(${name} INTERFACE "${_out_dir}/include")

    if(NOT "${MK_CUSTOM_DIR}" STREQUAL "")
        get_filename_component(_custom_abs "${MK_CUSTOM_DIR}" ABSOLUTE)
        execute_process(
            COMMAND "${_cli}" scaffold --mkui "${_mkui_abs}" --custom-dir "${_custom_abs}" ${_profile_args} ${_base_lib_args}
            RESULT_VARIABLE _scaf_rc
            ERROR_VARIABLE _scaf_err
        )
        if(NOT _scaf_rc EQUAL 0)
            message(FATAL_ERROR "[MoKairosUI] scaffold 失败:\n${_scaf_err}")
        endif()
        file(GLOB _custom_srcs CONFIGURE_DEPENDS "${_custom_abs}/*.c" "${_custom_abs}/*.cpp")
        set(_existing_norm "")
        if(NOT "${MK_TARGET}" STREQUAL "")
            get_target_property(_tgt_srcs "${MK_TARGET}" SOURCES)
            if(_tgt_srcs)
                foreach(_ts IN LISTS _tgt_srcs)
                    get_filename_component(_ts_abs "${_ts}" ABSOLUTE)
                    list(APPEND _existing_norm "${_ts_abs}")
                endforeach()
            endif()
        endif()
        foreach(_cs IN LISTS _custom_srcs)
            get_filename_component(_cs_abs "${_cs}" ABSOLUTE)
            list(FIND _existing_norm "${_cs_abs}" _found_idx)
            if(_found_idx GREATER_EQUAL 0)
                message(STATUS "[MoKairosUI] 检测到 ${_cs_abs} 已在目标 ${MK_TARGET} 源码中，跳过重复添加")
            else()
                target_sources(${name} INTERFACE "${_cs_abs}")
            endif()
        endforeach()
    endif()

    if(NOT "${MK_TARGET}" STREQUAL "")
        target_link_libraries(${MK_TARGET} PRIVATE ${name})
    endif()
endfunction()
