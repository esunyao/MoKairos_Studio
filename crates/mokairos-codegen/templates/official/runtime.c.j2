static uint16_t choose_sub_cmd(uint8_t count, uint8_t* out_slots) {
    if (count <= 1u) {
        *out_slots = 1u;
        return 0x0101u;
    }
    if (count == 2u) {
        *out_slots = 2u;
        return 0x0102u;
    }
    if (count <= 5u) {
        *out_slots = 5u;
        return 0x0103u;
    }
    *out_slots = 7u;
    return 0x0104u;
}

static {{ prefix }}_tx_t send_pack_with_op(const {{ prefix }}_pack_t* pack, uint8_t op) {
    if (pack->is_text) {
        const uint16_t gid = pack->graphics[0];
        const int16_t slot = {{ prefix }}_text_slot[gid];
        uint8_t content[45];
        memcpy(content, g_work_fig[gid], 15u);
        content[3] = (uint8_t)((content[3] & 0xF8u) | (op & 0x07u));
        if (slot >= 0) {
            memcpy(&content[15], g_work_text[slot], 30u);
        } else {
            memset(&content[15], 0, 30u);
        }
        return transmit_interaction(0x0110u, content, 45u);
    } else {
        uint8_t content[105];
        uint8_t slots = 1u;
        const uint16_t sub_cmd = choose_sub_cmd(pack->count, &slots);
        uint8_t i;
        memset(content, 0, sizeof(content));
        for (i = 0u; i < pack->count; ++i) {
            const uint16_t gid = pack->graphics[i];
            uint8_t* dst = &content[(size_t)i * 15u];
            memcpy(dst, g_work_fig[gid], 15u);
            if (op == 1u && g_hidden[gid] != 0u) {
                dst[3] = (uint8_t)(dst[3] & 0xF8u); /* 隐藏图元首包暂不 Add */
            } else {
                dst[3] = (uint8_t)((dst[3] & 0xF8u) | (op & 0x07u));
            }
        }
        return transmit_interaction(sub_cmd, content, (size_t)slots * 15u);
    }
}

static {{ prefix }}_tx_t send_next_active_update(uint8_t* out_sent) {
    const {{ prefix }}_frame_desc_t* fdesc = &{{ prefix }}_frames[g_active_frame];
    const uint16_t g_start = fdesc->graphic_offset;
    const uint16_t g_end = (uint16_t)(g_start + fdesc->graphic_count);
    uint16_t idx;
    *out_sent = 0u;

    /* 1. 优先发送脏/显隐变化的文字包（每包 1 个 0x0110） */
    for (idx = g_start; idx < g_end; ++idx) {
        uint8_t op = 0u;
        if (g_need_del[idx]) {
            op = 3u;
        } else if (g_need_add[idx]) {
            op = 1u;
        } else if (g_dirty[idx]) {
            op = 2u;
        }
        if (op != 0u && {{ prefix }}_fig_kind[idx] == 7u) {
            uint8_t content[45];
            const int16_t slot = {{ prefix }}_text_slot[idx];
            {{ prefix }}_tx_t res;
            memcpy(content, g_work_fig[idx], 15u);
            content[3] = (uint8_t)((content[3] & 0xF8u) | op);
            if (slot >= 0) {
                memcpy(&content[15], g_work_text[slot], 30u);
            } else {
                memset(&content[15], 0, 30u);
            }
            res = transmit_interaction(0x0110u, content, 45u);
            *out_sent = 1u;
            if (res == {{ prefix_upper }}_TX_ACCEPTED) {
                g_dirty[idx] = 0u;
                g_need_add[idx] = 0u;
                g_need_del[idx] = 0u;
            }
            return res;
        }
    }

    /* 2. 按同一分组打包最多 7 个脏图形 */
    {
        uint16_t batch_ids[7];
        uint8_t batch_ops[7];
        uint8_t batch_count = 0u;
        uint8_t batch_group = 0u;
        for (idx = g_start; idx < g_end; ++idx) {
            uint8_t op = 0u;
            if ({{ prefix }}_fig_kind[idx] == 7u) {
                continue;
            }
            if (g_need_del[idx]) {
                op = 3u;
            } else if (g_need_add[idx]) {
                op = 1u;
            } else if (g_dirty[idx]) {
                op = 2u;
            }
            if (op == 0u) {
                continue;
            }
            if (batch_count == 0u) {
                batch_group = {{ prefix }}_fig_group[idx];
            } else if ({{ prefix }}_fig_group[idx] != batch_group) {
                continue;
            }
            batch_ids[batch_count] = idx;
            batch_ops[batch_count] = op;
            batch_count++;
            if (batch_count == 7u) {
                break;
            }
        }
        if (batch_count > 0u) {
            uint8_t content[105];
            uint8_t slots = 1u;
            const uint16_t sub_cmd = choose_sub_cmd(batch_count, &slots);
            uint8_t i;
            {{ prefix }}_tx_t res;
            memset(content, 0, sizeof(content));
            for (i = 0u; i < batch_count; ++i) {
                const uint16_t gid = batch_ids[i];
                uint8_t* dst = &content[(size_t)i * 15u];
                memcpy(dst, g_work_fig[gid], 15u);
                dst[3] = (uint8_t)((dst[3] & 0xF8u) | batch_ops[i]);
            }
            res = transmit_interaction(sub_cmd, content, (size_t)slots * 15u);
            *out_sent = 1u;
            if (res == {{ prefix_upper }}_TX_ACCEPTED) {
                for (i = 0u; i < batch_count; ++i) {
                    const uint16_t gid = batch_ids[i];
                    g_dirty[gid] = 0u;
                    g_need_add[gid] = 0u;
                    g_need_del[gid] = 0u;
                }
            }
            return res;
        }
    }

    return {{ prefix_upper }}_TX_ACCEPTED;
}

{{ prefix }}_poll_t {{ prefix }}_poll(uint32_t now_ms) {
    uint16_t rid = 0u;
    int is_online = 0;
    int port_ready = 1;

{% if is_api_mode %}
    if (!g_port_bound) {
        return {{ prefix_upper }}_POLL_FAULT;
    }
    rid = g_port.robot_id(g_port.ctx);
    is_online = (g_port.online != NULL) ? g_port.online(g_port.ctx) : (rid != 0u ? 1 : 0);
    if (g_port.port_ready != NULL) {
        port_ready = g_port.port_ready(g_port.ctx);
    }
{% else %}
    rid = {{ prefix }}__rt_robot_id();
    is_online = {{ prefix }}__rt_online();
    port_ready = {{ prefix }}__rt_port_ready();
{% endif %}

    if (!is_online || !has_operator_client(rid)) {
        g_phase = MK_PHASE_OFFLINE;
        g_active_robot_id = 0u;
        g_pack_cursor = 0u;
        g_clear_layer_cursor = 0u;
        return {{ prefix_upper }}_POLL_IDLE;
    }

    if (g_active_robot_id != 0u && rid != g_active_robot_id) {
        g_phase = MK_PHASE_OFFLINE;
        g_active_robot_id = 0u;
        g_pack_cursor = 0u;
        g_clear_layer_cursor = 0u;
    }

    if (g_phase == MK_PHASE_FAULT) {
        return {{ prefix_upper }}_POLL_FAULT;
    }

    if (g_phase == MK_PHASE_OFFLINE) {
        g_active_robot_id = rid;
        g_active_frame = g_pending_frame;
        g_pack_cursor = 0u;
        g_clear_layer_cursor = 0u;
        g_redraw_req = 0u;
        g_phase = MK_PHASE_ADDING;
{% if custom_hooks %}
        {{ prefix }}_custom_on_session_start();
{% endif %}
    }

    if (g_has_tx != 0u && (uint32_t)(now_ms - g_last_tx_ms) < {{ prefix_upper }}_MIN_INTERVAL_MS) {
        return {{ prefix_upper }}_POLL_DEFERRED;
    }

    if (!port_ready) {
        return {{ prefix_upper }}_POLL_DEFERRED;
    }

    if (g_phase == MK_PHASE_ADDING) {
        const {{ prefix }}_frame_desc_t* fdesc = &{{ prefix }}_frames[g_active_frame];
#if {{ prefix_upper }}_CLEAR_LAYERS_ON_START
        while (g_clear_layer_cursor < 10u) {
            const uint16_t bit = (uint16_t)(1u << g_clear_layer_cursor);
            if ((fdesc->layer_mask & bit) != 0u) {
                uint8_t del_content[2];
                {{ prefix }}_tx_t tx;
                del_content[0] = 1u;
                del_content[1] = g_clear_layer_cursor;
                tx = transmit_interaction(0x0100u, del_content, 2u);
                if (tx == {{ prefix_upper }}_TX_ACCEPTED) {
                    g_clear_layer_cursor++;
                    g_last_tx_ms = now_ms;
                    g_has_tx = 1u;
                    return {{ prefix_upper }}_POLL_SENT;
                } else if (tx == {{ prefix_upper }}_TX_BUSY) {
                    return {{ prefix_upper }}_POLL_DEFERRED;
                } else {
                    g_phase = MK_PHASE_FAULT;
                    return {{ prefix_upper }}_POLL_FAULT;
                }
            }
            g_clear_layer_cursor++;
        }
#endif
        if (g_pack_cursor < fdesc->pack_count) {
            const {{ prefix }}_pack_t* pack = &{{ prefix }}_packs[fdesc->pack_offset + g_pack_cursor];
            const {{ prefix }}_tx_t tx = send_pack_with_op(pack, 1u);
            if (tx == {{ prefix_upper }}_TX_ACCEPTED) {
                uint8_t k;
                for (k = 0u; k < pack->count; ++k) {
                    const uint16_t gid = pack->graphics[k];
                    if (g_hidden[gid] == 0u) {
                        g_dirty[gid] = 0u;
                        g_need_add[gid] = 0u;
                    }
                }
                g_pack_cursor++;
                g_last_tx_ms = now_ms;
                g_has_tx = 1u;
                if (g_pack_cursor >= fdesc->pack_count) {
                    g_phase = MK_PHASE_ACTIVE;
{% if custom_hooks %}
                    {{ prefix }}_custom_on_frame_ready(({{ prefix }}_frame_t)g_active_frame);
{% endif %}
                }
                return {{ prefix_upper }}_POLL_SENT;
            } else if (tx == {{ prefix_upper }}_TX_BUSY) {
                return {{ prefix_upper }}_POLL_DEFERRED;
            } else {
                g_phase = MK_PHASE_FAULT;
                return {{ prefix_upper }}_POLL_FAULT;
            }
        }
        g_phase = MK_PHASE_ACTIVE;
{% if custom_hooks %}
        {{ prefix }}_custom_on_frame_ready(({{ prefix }}_frame_t)g_active_frame);
{% endif %}
        return {{ prefix_upper }}_POLL_IDLE;
    }

    if (g_phase == MK_PHASE_DELETING) {
        const {{ prefix }}_frame_desc_t* fdesc = &{{ prefix }}_frames[g_active_frame];
        if (g_pack_cursor < fdesc->pack_count) {
            const {{ prefix }}_pack_t* pack = &{{ prefix }}_packs[fdesc->pack_offset + g_pack_cursor];
            const {{ prefix }}_tx_t tx = send_pack_with_op(pack, 3u);
            if (tx == {{ prefix_upper }}_TX_ACCEPTED) {
                g_pack_cursor++;
                g_last_tx_ms = now_ms;
                g_has_tx = 1u;
                if (g_pack_cursor >= fdesc->pack_count) {
                    g_active_frame = g_pending_frame;
                    g_pack_cursor = 0u;
                    g_clear_layer_cursor = 0u;
                    g_redraw_req = 0u;
                    g_phase = MK_PHASE_ADDING;
                }
                return {{ prefix_upper }}_POLL_SENT;
            } else if (tx == {{ prefix_upper }}_TX_BUSY) {
                return {{ prefix_upper }}_POLL_DEFERRED;
            } else {
                g_phase = MK_PHASE_FAULT;
                return {{ prefix_upper }}_POLL_FAULT;
            }
        }
        g_active_frame = g_pending_frame;
        g_pack_cursor = 0u;
        g_clear_layer_cursor = 0u;
        g_redraw_req = 0u;
        g_phase = MK_PHASE_ADDING;
        return {{ prefix_upper }}_POLL_IDLE;
    }

    /* ACTIVE 状态 */
    if (g_pending_frame != g_active_frame || g_redraw_req != 0u) {
        g_pack_cursor = 0u;
        g_phase = MK_PHASE_DELETING;
        return {{ prefix_upper }}_POLL_DEFERRED;
    }

    {{ prefix }}__sync(now_ms);
{% if custom_hooks %}
    {{ prefix }}_custom_on_tick(now_ms);
{% endif %}

    {
        uint8_t attempted = 0u;
        const {{ prefix }}_tx_t tx = send_next_active_update(&attempted);
        if (attempted == 0u) {
            return {{ prefix_upper }}_POLL_IDLE;
        }
        if (tx == {{ prefix_upper }}_TX_ACCEPTED) {
            g_last_tx_ms = now_ms;
            g_has_tx = 1u;
            return {{ prefix_upper }}_POLL_SENT;
        } else if (tx == {{ prefix_upper }}_TX_BUSY) {
            return {{ prefix_upper }}_POLL_DEFERRED;
        } else {
            g_phase = MK_PHASE_FAULT;
            return {{ prefix_upper }}_POLL_FAULT;
        }
    }
}

{% if has_now_ms %}
{{ prefix }}_poll_t {{ prefix }}_poll_auto(void) {
    return {{ prefix }}_poll({{ prefix }}__rt_now_ms());
}
{% endif %}
