            }
            break;
        case 7u: /* width */
            if (value < 1 || value > 1023) return 0;
            {
                const uint32_t nw2 = (w2 & ~0x3FFu) | ((uint32_t)value & 0x3FFu);
                changed = (nw2 != w2);
                w2 = nw2;
            }
            break;
        default:
            return 0;
    }
    if (!changed) {
        return 1;
    }
    put_le32(&g_work_fig[id][3], w1);
    put_le32(&g_work_fig[id][7], w2);
    put_le32(&g_work_fig[id][11], w3);
    mark_dirty(id);
    return 1;
}

int {{ prefix }}__set_visible(uint16_t id, int visible) {
    uint8_t next_hidden;
    if (id >= (uint16_t){{ prefix_upper }}_G_COUNT) {
        return 0;
    }
    next_hidden = (visible == 0) ? 1u : 0u;
    if (g_hidden[id] == next_hidden) {
        return 1;
    }
    g_hidden[id] = next_hidden;
    if (next_hidden) {
        g_dirty[id] = 0u;
        g_need_add[id] = 0u;
        g_need_del[id] = 1u;
    } else {
        g_need_del[id] = 0u;
        g_need_add[id] = 1u;
    }
    return 1;
}

